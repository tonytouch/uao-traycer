<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug-variant overlay. The dev loop is entirely plain-http loopback: the
    live-reload bundle, the authn/cloud-ui origins baked by `vite.config.ts`,
    and the host's `ws://127.0.0.1:<port>` RPC socket.

    `src/debug/res` replaces `src/main/res/xml/network_security_config.xml`.
    Release keeps the main file, which allows cleartext so Tailscale
    `http://100.x` can load. Debug narrows that back to loopback.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application android:networkSecurityConfig="@xml/network_security_config" />
</manifest>
