# Copied to ~/.config/uao-serve/uao-serve.env by install.sh. Edit before starting.
#
# The browser origin the phone uses. It must match the `tailscale serve` HTTPS
# port exactly (scheme + host + port, no path). Find the host name with:
#   tailscale status --json | python3 -c 'import sys,json;print(json.load(sys.stdin)["Self"]["DNSName"].rstrip("."))'
UAO_SERVE_ALLOWED_ORIGINS=https://server.tail85e19.ts.net:10000

# Loopback port that `tailscale serve` forwards to.
UAO_SERVE_PORT=5191

# Agent OS backend (it exempts loopback callers; no token needed from here).
UAO_BACKEND_PORT=5050

# Workspace and agent-terminal routes run local processes and are off by default. Leave off
# for the phone; "1" turns them on (they then also demand the pairing header,
# so the phone cookie alone still gets no terminal).
UAO_SERVE_WORKSPACES=0
