 MODELS = ["claude-code", "codex", "opencode", "antigravity", "freebuff"]
 
 
+# Office clients attach opaque request ids so Stop can terminate the entire CLI
+# process group. Clients without ids retain the ordinary chat API behavior.
+_JOBS = {}
+_RECENT = {}
+_JOBS_LOCK = threading.Lock()
+_CONTEXT = threading.local()
+
+
+class GatewayCancelled(Exception):
+    pass
+
+
+class RequestJob:
+    def __init__(self):
+        self.cancelled = threading.Event()
+
+
+def _prune_recent():
+    now = time.monotonic()
+    for key, expiry in list(_RECENT.items()):
+        if expiry < now:
+            del _RECENT[key]
+
+
+def cancel_request(request_id):
+    with _JOBS_LOCK:
+        _prune_recent()
+        job = _JOBS.get(request_id)
+        if job:
+            job.cancelled.set()
+        # Covers Stop arriving before the completion handler registered its job.
+        if len(_RECENT) >= 4096:
+            _RECENT.pop(next(iter(_RECENT)))
+        _RECENT[request_id] = time.monotonic() + 60
+    return job is not None
+
+
+def _kill_group(proc):
+    try:
+        os.killpg(proc.pid, signal.SIGTERM)
+    except ProcessLookupError:
+        return
+    time.sleep(0.2)
+    try:
+        os.killpg(proc.pid, signal.SIGKILL)
+    except ProcessLookupError:
+        pass
+
+
+def _run_process(args, *, input=None, stdin=None, capture_output=True,
+                 text=True, timeout=None, cwd=None):
+    job = getattr(_CONTEXT, 'job', None)
+    if job and job.cancelled.is_set():
+        raise GatewayCancelled()
+    proc = subprocess.Popen(args, stdin=subprocess.PIPE if input is not None else stdin,
+                            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
+                            text=text, cwd=cwd, start_new_session=True)
+    deadline = time.monotonic() + (timeout or TIMEOUT_S)
+    pending_input = input
+    try:
+        while True:
+            if job and job.cancelled.is_set():
+                raise GatewayCancelled()
+            remaining = deadline - time.monotonic()
+            if remaining <= 0:
+                raise subprocess.TimeoutExpired(args, timeout)
+            try:
+                out, err = proc.communicate(pending_input, timeout=min(0.2, remaining))
+                if job and job.cancelled.is_set():
+                    raise GatewayCancelled()
+                return subprocess.CompletedProcess(args, proc.returncode, out, err)
+            except subprocess.TimeoutExpired:
+                pending_input = None
+    except BaseException:
+        _kill_group(proc)
+        proc.communicate()
+        raise
+
